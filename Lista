<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#081a14" />
  <title>Pelada ao Vivo</title>
  <style>
    :root {
      --bg: #07130f; --panel: #0d211a; --panel2: #123126; --line: #21493a;
      --text: #f3fff8; --muted: #a8c7b9; --green: #3de08d; --green2: #20b96d;
      --yellow: #ffd166; --red: #ff6b6b; --blue: #64b5f6; --shadow: 0 14px 38px rgba(0,0,0,.28);
    }
    * { box-sizing: border-box; }
    body { margin: 0; min-width: 320px; background: radial-gradient(circle at top, #123426 0, var(--bg) 33%); color: var(--text); font-family: Inter, ui-sans-serif, system-ui, -apple-system, Segoe UI, sans-serif; }
    button, input, select { font: inherit; }
    button { cursor: pointer; }
    .app { max-width: 1120px; margin: auto; padding: 18px; }
    header { display: flex; justify-content: space-between; gap: 18px; align-items: center; margin: 6px 0 20px; }
    .brand { display:flex; align-items:center; gap:12px; }
    .ball { width: 48px; height: 48px; display:grid; place-items:center; border-radius:16px; background: linear-gradient(145deg,var(--green),var(--green2)); color:#062015; font-size:25px; box-shadow:0 10px 25px rgba(61,224,141,.25); }
    h1 { font-size: clamp(1.3rem, 4vw, 2rem); margin: 0; letter-spacing:-.04em; }
    .subtitle, .muted { color: var(--muted); }
    .subtitle { font-size:.9rem; margin-top:3px; }
    .status { padding: 8px 12px; border:1px solid var(--line); border-radius:999px; color:var(--green); background:rgba(61,224,141,.08); font-size:.8rem; white-space:nowrap; }
    .grid { display:grid; grid-template-columns: .95fr 1.35fr; gap:18px; align-items:start; }
    .card { background: linear-gradient(160deg, rgba(18,49,38,.96), rgba(10,31,24,.96)); border:1px solid var(--line); border-radius:22px; padding:18px; box-shadow:var(--shadow); }
    .card + .card { margin-top:18px; }
    .card-title { display:flex; align-items:center; justify-content:space-between; gap:10px; margin-bottom:14px; }
    h2 { margin:0; font-size:1.02rem; }
    .badge { color: var(--muted); background:#0a1d17; border:1px solid var(--line); border-radius:999px; padding:5px 9px; font-size:.75rem; }
    .form-row { display:grid; grid-template-columns:1fr auto; gap:9px; }
    input, select { width:100%; color:var(--text); background:#071a13; border:1px solid var(--line); border-radius:12px; padding:12px; outline:none; }
    input:focus, select:focus { border-color:var(--green); box-shadow:0 0 0 3px rgba(61,224,141,.12); }
    .btn { border:0; border-radius:12px; padding:11px 14px; font-weight:750; color:#062015; background:var(--green); transition:.18s ease; }
    .btn:hover { transform:translateY(-1px); filter:brightness(1.05); }
    .btn.secondary { color:var(--text); background:#173d30; border:1px solid var(--line); }
    .btn.danger { color:#ffe8e8; background:#542626; }
    .btn.small { padding:7px 9px; font-size:.78rem; border-radius:9px; }
    .goalies { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    label { display:block; color:var(--muted); font-size:.78rem; margin-bottom:6px; }
    .help { margin:10px 0 0; font-size:.78rem; line-height:1.45; color:var(--muted); }
    .queue { display:flex; flex-direction:column; gap:8px; min-height:68px; }
    .player { display:flex; align-items:center; gap:10px; padding:10px; background:#091c15; border:1px solid var(--line); border-radius:13px; }
    .player.dragging { opacity:.45; }
    .handle { color:#6f9b87; cursor:grab; user-select:none; font-size:1.1rem; }
    .position { width:28px; height:28px; display:grid; place-items:center; border-radius:9px; color:#032015; background:var(--green); font-weight:850; font-size:.78rem; }
    .player-name { flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .arrival { color:var(--muted); font-size:.68rem; }
    .icon-btn { border:0; background:transparent; color:var(--muted); padding:5px; border-radius:8px; }
    .icon-btn:hover { color:var(--red); background:rgba(255,107,107,.1); }
    .empty { padding:20px 10px; border:1px dashed var(--line); border-radius:13px; text-align:center; color:var(--muted); font-size:.86rem; }
    .setup { border:1px solid rgba(255,209,102,.35); background:rgba(255,209,102,.06); border-radius:16px; padding:14px; margin-bottom:16px; }
    .setup h3 { margin:0 0 5px; font-size:.95rem; color:var(--yellow); }
    .setup p { margin:0 0 12px; color:var(--muted); font-size:.8rem; line-height:1.45; }
    .pick-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .pick-box { padding:10px; background:#071a13; border:1px solid var(--line); border-radius:13px; }
    .pick-box strong { display:block; margin-bottom:8px; font-size:.83rem; }
    .check { display:flex; gap:8px; align-items:center; margin:5px 0; color:var(--text); font-size:.8rem; }
    .check input { width:auto; accent-color:var(--green); }
    .match { display:grid; grid-template-columns:1fr 48px 1fr; gap:10px; align-items:stretch; }
    .team { min-width:0; padding:14px; background:#091c15; border:1px solid var(--line); border-radius:16px; }
    .team.a { border-top:3px solid var(--blue); } .team.b { border-top:3px solid var(--yellow); }
    .team h3 { margin:0 0 10px; font-size:.95rem; }
    .team ul { list-style:none; padding:0; margin:0; display:flex; flex-direction:column; gap:7px; }
    .team li { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; font-size:.82rem; padding-bottom:6px; border-bottom:1px solid rgba(255,255,255,.06); }
    .team li:last-child { border:0; }
    .gk { color:var(--green); font-weight:750; }
    .versus { display:grid; place-items:center; color:var(--muted); font-weight:900; }
    .actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:14px; }
    .notice { margin-top:12px; padding:10px 12px; border-radius:12px; color:var(--muted); background:#081b15; font-size:.78rem; line-height:1.45; }
    .history-item { padding:10px 0; border-bottom:1px solid var(--line); font-size:.8rem; }
    .history-item:last-child { border:0; }
    .history-item strong { color:var(--green); }
    .footer-actions { display:flex; gap:8px; justify-content:flex-end; margin-top:18px; }
    .toast { position:fixed; left:50%; bottom:20px; transform:translateX(-50%) translateY(100px); opacity:0; background:#f4fff8; color:#092019; padding:11px 15px; border-radius:12px; font-weight:750; box-shadow:var(--shadow); transition:.25s; z-index:20; }
    .toast.show { transform:translateX(-50%) translateY(0); opacity:1; }
    @media (max-width:760px) { .grid { grid-template-columns:1fr; } header { align-items:flex-start; } .status { display:none; } }
    @media (max-width:430px) { .app{padding:12px}.card{padding:14px;border-radius:18px}.match{grid-template-columns:1fr}.versus{height:24px}.pick-grid,.goalies{grid-template-columns:1fr}.form-row{grid-template-columns:1fr}.form-row .btn{width:100%} }
  </style>
</head>
<body>
  <main class="app">
    <header>
      <div class="brand"><div class="ball">⚽</div><div><h1>Pelada ao Vivo</h1><div class="subtitle">Presença, fila e times sem papel</div></div></div>
      <div class="status">● dados salvos neste aparelho</div>
    </header>

    <div class="grid">
      <section>
        <div class="card">
          <div class="card-title"><h2>Configuração</h2><span class="badge">2 goleiros fixos</span></div>
          <div class="goalies">
            <div><label for="gkA">Goleiro do Time A</label><input id="gkA" placeholder="Nome do goleiro" /></div>
            <div><label for="gkB">Goleiro do Time B</label><input id="gkB" placeholder="Nome do goleiro" /></div>
          </div>
          <p class="help">Cada time terá 1 goleiro fixo + 5 jogadores de linha. Os goleiros não entram na rotação.</p>
        </div>

        <div class="card">
          <div class="card-title"><h2>Lista de presença</h2><span class="badge" id="countBadge">0 na fila</span></div>
          <form id="addForm" class="form-row">
            <input id="playerInput" maxlength="30" autocomplete="off" placeholder="Nome de quem chegou" aria-label="Nome do jogador" />
            <button class="btn" type="submit">Adicionar</button>
          </form>
          <p class="help">Quem chega entra no fim. Arraste os nomes para corrigir a ordem.</p>
          <div id="queue" class="queue" aria-live="polite"></div>
        </div>
      </section>

      <section>
        <div class="card">
          <div class="card-title"><h2>Jogo atual</h2><span class="badge" id="roundBadge">Aguardando</span></div>
          <div id="initialSetup" class="setup"></div>
          <div id="matchArea"></div>
        </div>

        <div class="card">
          <div class="card-title"><h2>Próximo jogo</h2><span class="badge">prévia automática</span></div>
          <div id="nextMatch"></div>
        </div>

        <div class="card">
          <div class="card-title"><h2>Histórico</h2><button id="clearHistory" class="btn small secondary" type="button">Limpar</button></div>
          <div id="history"></div>
        </div>
      </section>
    </div>

    <div class="footer-actions">
      <button id="exportBtn" class="btn secondary" type="button">Exportar dados</button>
      <button id="resetBtn" class="btn danger" type="button">Reiniciar noite</button>
    </div>
  </main>
  <div id="toast" class="toast" role="status" aria-live="polite"></div>

<script>
(() => {
  const KEY = 'peladaAoVivo_v1';
  const initial = { players: [], goalies: {a:'',b:''}, current: null, round: 0, history: [] };
  let state = load();
  let dragIndex = null;
  const $ = id => document.getElementById(id);

  function load(){ try { return {...initial, ...JSON.parse(localStorage.getItem(KEY) || '{}')}; } catch { return structuredClone(initial); } }
  function save(){ localStorage.setItem(KEY, JSON.stringify(state)); }
  function esc(s=''){ return String(s).replace(/[&<>'"]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c])); }
  function toast(msg){ const el=$('toast'); el.textContent=msg; el.classList.add('show'); setTimeout(()=>el.classList.remove('show'),1800); }
  function time(){ return new Date().toLocaleTimeString('pt-BR',{hour:'2-digit',minute:'2-digit'}); }
  function uniqueName(name){ return !state.players.some(p=>p.name.toLowerCase()===name.toLowerCase()) && !(state.current?.teamA||[]).concat(state.current?.teamB||[]).some(n=>n.toLowerCase()===name.toLowerCase()); }

  function addPlayer(name){
    name=name.trim().replace(/\s+/g,' ');
    if(!name) return toast('Digite o nome do jogador.');
    if(!uniqueName(name)) return toast('Esse jogador já está na lista ou em campo.');
    state.players.push({id:crypto.randomUUID(),name,arrival:time()}); save(); render(); toast(`${name} entrou no fim da fila.`);
  }

  function removePlayer(id){
    const p=state.players.find(x=>x.id===id); if(!p) return;
    state.players=state.players.filter(x=>x.id!==id); save(); render(); toast(`${p.name} removido.`);
  }

  function renderQueue(){
    $('countBadge').textContent=`${state.players.length} na fila`;
    $('queue').innerHTML=state.players.length ? state.players.map((p,i)=>`
      <div class="player" draggable="true" data-index="${i}">
        <span class="handle" title="Arrastar">☰</span><span class="position">${i+1}</span>
        <span class="player-name">${esc(p.name)}</span><span class="arrival">${esc(p.arrival)}</span>
        <button class="icon-btn remove" data-id="${p.id}" type="button" aria-label="Remover ${esc(p.name)}">✕</button>
      </div>`).join('') : '<div class="empty">A lista está vazia. Adicione os jogadores conforme chegarem.</div>';
    document.querySelectorAll('.remove').forEach(b=>b.addEventListener('click',()=>removePlayer(b.dataset.id)));
    document.querySelectorAll('.player').forEach(el=>{
      el.addEventListener('dragstart',()=>{dragIndex=+el.dataset.index; el.classList.add('dragging')});
      el.addEventListener('dragend',()=>el.classList.remove('dragging'));
      el.addEventListener('dragover',e=>e.preventDefault());
      el.addEventListener('drop',e=>{e.preventDefault(); const to=+el.dataset.index; if(dragIndex===null||to===dragIndex)return; const [m]=state.players.splice(dragIndex,1); state.players.splice(to,0,m); dragIndex=null; save(); render();});
    });
  }

  function playerChecks(team){
    return state.players.slice(0,10).map((p,i)=>`<label class="check"><input type="checkbox" name="${team}" value="${p.id}"><span>${i+1}. ${esc(p.name)}</span></label>`).join('');
  }

  function renderInitialSetup(){
    const box=$('initialSetup');
    if(state.round>0 || state.current){ box.style.display='none'; return; }
    box.style.display='block';
    if(state.players.length<10){ box.innerHTML=`<h3>Primeiro jogo</h3><p>Adicione pelo menos 10 jogadores de linha. Faltam <strong>${10-state.players.length}</strong>.</p>`; return; }
    box.innerHTML=`<h3>Escolha manual dos 10 primeiros</h3><p>Selecione exatamente 5 para cada time. Apenas os 10 primeiros da presença aparecem aqui.</p>
      <div class="pick-grid"><div class="pick-box"><strong>Time A</strong>${playerChecks('a')}</div><div class="pick-box"><strong>Time B</strong>${playerChecks('b')}</div></div>
      <div class="actions"><button id="startBtn" type="button" class="btn">Iniciar primeiro jogo</button><button id="autoPick" type="button" class="btn secondary">Dividir alternado</button></div>`;
    $('autoPick').addEventListener('click',()=>{ document.querySelectorAll('input[name=a],input[name=b]').forEach(x=>x.checked=false); state.players.slice(0,10).forEach((p,i)=>{ document.querySelector(`input[name=${i%2?'b':'a'}][value="${p.id}"]`).checked=true; }); });
    $('startBtn').addEventListener('click',startInitial);
  }

  function getChecked(name){ return [...document.querySelectorAll(`input[name=${name}]:checked`)].map(x=>x.value); }
  function startInitial(){
    if(!state.goalies.a.trim()||!state.goalies.b.trim()) return toast('Preencha os dois goleiros fixos.');
    const a=getChecked('a'), b=getChecked('b');
    if(a.length!==5||b.length!==5) return toast('Selecione 5 jogadores para cada time.');
    if(a.some(id=>b.includes(id))) return toast('Um jogador não pode estar nos dois times.');
    const ids=[...a,...b];
    const names=ids.map(id=>state.players.find(p=>p.id===id)?.name);
    if(names.some(n=>!n)) return toast('Revise a seleção dos jogadores.');
    state.current={teamA:a.map(id=>state.players.find(p=>p.id===id).name),teamB:b.map(id=>state.players.find(p=>p.id===id).name),started:time()};
    state.players=state.players.filter(p=>!ids.includes(p.id)); state.round=1; save(); render(); toast('Primeiro jogo iniciado!');
  }

  function teamHtml(title, players, goalie, cls){
    return `<div class="team ${cls}"><h3>${title}</h3><ul><li class="gk">🧤 ${esc(goalie||'Goleiro não definido')}</li>${players.map(n=>`<li>⚽ ${esc(n)}</li>`).join('')}</ul></div>`;
  }
  function matchHtml(match, preview=false){
    if(!match) return `<div class="empty">${preview?'A prévia aparecerá quando houver 10 jogadores na fila.':'Nenhum jogo em andamento.'}</div>`;
    return `<div class="match">${teamHtml('Time A',match.teamA,state.goalies.a,'a')}<div class="versus">X</div>${teamHtml('Time B',match.teamB,state.goalies.b,'b')}</div>`;
  }

  function renderMatch(){
    $('roundBadge').textContent=state.current?`Rodada ${state.round}`:'Aguardando';
    $('matchArea').innerHTML=matchHtml(state.current)+(state.current?`<div class="actions"><button id="finishBtn" class="btn" type="button">Encerrar e girar fila</button><button id="cancelBtn" class="btn secondary" type="button">Devolver à fila</button></div><div class="notice">Ao encerrar, os 10 jogadores de linha voltam para o fim da fila. Os próximos 10 assumem a rodada seguinte, 5 em cada time.</div>`:'');
    if(state.current){ $('finishBtn').addEventListener('click',finishMatch); $('cancelBtn').addEventListener('click',cancelMatch); }
  }

  function nextPreview(){ if(state.players.length<10)return null; return {teamA:state.players.slice(0,5).map(p=>p.name),teamB:state.players.slice(5,10).map(p=>p.name)}; }
  function renderNext(){ $('nextMatch').innerHTML=matchHtml(nextPreview(),true)+(state.players.length<10?`<div class="notice">Faltam ${10-state.players.length} jogadores na fila para formar a próxima rodada completa.</div>`:''); }

  function finishMatch(){
    if(!state.current)return;
    const played=[...state.current.teamA,...state.current.teamB];
    state.history.unshift({round:state.round,teamA:state.current.teamA,teamB:state.current.teamB,ended:time()});
    played.forEach(name=>state.players.push({id:crypto.randomUUID(),name,arrival:'retorno'}));
    state.current=null;
    if(state.players.length>=10){ const selected=state.players.splice(0,10); state.current={teamA:selected.slice(0,5).map(p=>p.name),teamB:selected.slice(5).map(p=>p.name),started:time()}; state.round+=1; }
    save(); render(); toast(state.current?'Próxima rodada formada.':'Jogo encerrado. Aguardando jogadores.');
  }

  function cancelMatch(){
    if(!state.current)return;
    const back=[...state.current.teamA,...state.current.teamB].map(name=>({id:crypto.randomUUID(),name,arrival:'devolvido'}));
    state.players=[...back,...state.players]; state.current=null; if(state.round===1&&state.history.length===0)state.round=0; save(); render(); toast('Jogadores devolvidos ao início da fila.');
  }

  function renderHistory(){
    $('history').innerHTML=state.history.length?state.history.map(h=>`<div class="history-item"><strong>Rodada ${h.round}</strong> · encerrada ${esc(h.ended)}<br><span class="muted">A: ${h.teamA.map(esc).join(', ')} | B: ${h.teamB.map(esc).join(', ')}</span></div>`).join(''):'<div class="empty">Os jogos encerrados aparecerão aqui.</div>';
  }

  function render(){
    $('gkA').value=state.goalies.a; $('gkB').value=state.goalies.b;
    renderQueue(); renderInitialSetup(); renderMatch(); renderNext(); renderHistory();
  }

  $('addForm').addEventListener('submit',e=>{e.preventDefault(); addPlayer($('playerInput').value); $('playerInput').value=''; $('playerInput').focus();});
  ['gkA','gkB'].forEach((id,i)=>$(id).addEventListener('input',e=>{state.goalies[i?'b':'a']=e.target.value; save(); renderMatch(); renderNext();}));
  $('clearHistory').addEventListener('click',()=>{state.history=[];save();renderHistory();toast('Histórico limpo.');});
  $('resetBtn').addEventListener('click',()=>{if(confirm('Reiniciar a noite e apagar fila, jogo e histórico?')){state=structuredClone(initial);save();render();toast('Noite reiniciada.');}});
  $('exportBtn').addEventListener('click',()=>{
    const blob=new Blob([JSON.stringify(state,null,2)],{type:'application/json'}); const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=`pelada-${new Date().toISOString().slice(0,10)}.json`; a.click(); URL.revokeObjectURL(a.href);
  });
  render();
})();
</script>
</body>
</html>
